# ---------------------------------------------------------------------------
# STOCKFUN — THE LODE
#
# Everything here is optional. With no configuration the game runs end to end
# in SIMULATION mode: payouts are computed and recorded exactly as they would
# be on-chain, but nothing is broadcast and every payout is flagged
# `simulated` all the way to the UI.
# ---------------------------------------------------------------------------

# --- Chain -----------------------------------------------------------------
# "mainnet" (chain id 4663) or "testnet" (chain id 46630).
RHC_NETWORK=mainnet
NEXT_PUBLIC_RHC_NETWORK=mainnet

# The public endpoint is rate-limited; point these at a dedicated RPC provider
# before running anything real.
RHC_RPC_URL=https://rpc.mainnet.chain.robinhood.com
RHC_TESTNET_RPC_URL=https://rpc.testnet.chain.robinhood.com

# --- Vault -----------------------------------------------------------------
# Private key of the wallet holding the Stock Tokens that back the map.
# Leave unset to stay in simulation mode. This key can move real assets —
# keep it in a secret manager, never in the repository.
# VAULT_PRIVATE_KEY=0x...

# ERC-20 addresses of the Stock Tokens you have seeded, as TICKER:ADDRESS
# pairs. Any ticker left out stays in simulation even when the vault key is set.
# STOCK_TOKEN_ADDRESSES=NVDA:0x...,AAPL:0x...,HOOD:0x...

# --- World -----------------------------------------------------------------
# The spawn seed decides where every cache is buried. It must never reach the
# browser, and changing it re-rolls the entire map.
SPAWN_SEED=3238002754

# Where the claim ledger and profiles are written.
LODE_DATA_DIR=./data

# --- Operations ------------------------------------------------------------
# Required by /api/seed, which reports the vault manifest for a region and
# opens a new seeding epoch.
# ADMIN_KEY=change-me
